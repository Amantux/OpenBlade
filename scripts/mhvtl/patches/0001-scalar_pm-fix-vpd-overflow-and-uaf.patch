diff --git a/usr/pm/scalar_pm.c b/usr/pm/scalar_pm.c
index 0fc4fce..df3504c 100644
--- a/usr/pm/scalar_pm.c
+++ b/usr/pm/scalar_pm.c
@@ -3,11 +3,16 @@
  */
 
 #include <stdio.h>
+#include <string.h>
 #include "vtllib.h"
 #include "smc.h"
 #include "logging.h"
 #include "be_byteshift.h"
 
+/* Payload sizes of the VPD pages this personality builds. */
+#define VPD_80_SZ		 24
+#define VPD_83_SCALAR_SZ 36
+
 static struct smc_personality_template smc_pm = {
 	.library_has_map			= TRUE,
 	.library_has_barcode_reader = TRUE,
@@ -35,7 +40,7 @@ static void init_scalar_inquiry(struct lu_phy_attr *lu) {
 
 static void update_scalar_vpd_80(struct lu_phy_attr *lu) {
 	struct vpd *lu_vpd;
-	uint8_t	   *d;
+	char		scratch[VPD_80_SZ + 1];
 
 	lu_vpd = lu->lu_vpd[PCODE_OFFSET(0x80)];
 
@@ -43,19 +48,27 @@ static void update_scalar_vpd_80(struct lu_phy_attr *lu) {
 	if (lu_vpd) /* Free any earlier allocation */
 		dealloc_vpd(lu_vpd);
 
-	lu_vpd = alloc_vpd(24);
+	lu_vpd = alloc_vpd(VPD_80_SZ);
+	/* Install the new page before anything can use the stale pointer. */
+	lu->lu_vpd[PCODE_OFFSET(0x80)] = lu_vpd;
 	if (lu_vpd) {
-		d = lu_vpd->data;
-		/* d[4 - 27] Serial number prefixed by Vendor ID */
-		snprintf((char *)&d[0], 26, "%-s%-17s", lu->vendor_id, lu->lu_serial_no);
+		/* Serial number prefixed by Vendor ID, space padded, NOT NUL
+		 * terminated: the page is exactly VPD_80_SZ bytes of payload.
+		 * Render into scratch (which has room for the terminator) and
+		 * copy only the payload across.
+		 */
+		snprintf(scratch, sizeof(scratch), "%-s%-17s", lu->vendor_id,
+				 lu->lu_serial_no);
+		memcpy(lu_vpd->data, scratch, VPD_80_SZ);
 	} else {
-		MHVTL_ERR("Could not malloc(24) bytes, line %d", __LINE__);
+		MHVTL_ERR("Could not malloc(%d) bytes, line %d", VPD_80_SZ, __LINE__);
 	}
 }
 
 static void update_scalar_vpd_83(struct lu_phy_attr *lu) {
 	struct vpd *lu_vpd;
 	uint8_t	   *d;
+	char		scratch[VPD_83_SCALAR_SZ + 1];
 
 	lu_vpd = lu->lu_vpd[PCODE_OFFSET(0x83)];
 
@@ -63,17 +76,25 @@ static void update_scalar_vpd_83(struct lu_phy_attr *lu) {
 	if (lu_vpd) /* Free any earlier allocation */
 		dealloc_vpd(lu_vpd);
 
-	lu_vpd = alloc_vpd(36);
+	lu_vpd = alloc_vpd(VPD_83_SCALAR_SZ);
+	/* Install the new page before anything can use the stale pointer. */
+	lu->lu_vpd[PCODE_OFFSET(0x83)] = lu_vpd;
 	if (lu_vpd) {
 		d	 = lu_vpd->data;
 		d[0] = 0xf2;
 		d[1] = 0x01;
 		d[3] = 0x20;
-		snprintf((char *)&d[4], 9, "%-8s", lu->vendor_id);
-		snprintf((char *)&d[12], 25, "%-24s", lu->lu_serial_no);
-
+		/* d[4 - 11]  vendor id, d[12 - 35] serial number. Both are space
+		 * padded and NOT NUL terminated - writing a terminator after the
+		 * serial number would run one byte past the page.
+		 */
+		snprintf(scratch, sizeof(scratch), "%-8s", lu->vendor_id);
+		memcpy(&d[4], scratch, 8);
+		snprintf(scratch, sizeof(scratch), "%-24s", lu->lu_serial_no);
+		memcpy(&d[12], scratch, 24);
 	} else {
-		MHVTL_ERR("Could not malloc(36) bytes, line %d", __LINE__);
+		MHVTL_ERR("Could not malloc(%d) bytes, line %d", VPD_83_SCALAR_SZ,
+				  __LINE__);
 	}
 }
 
