# Copy to deploy/lan/.env (gitignored by .env*) and fill EVERY value.
# Generate each secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"

# Interface to publish on (0.0.0.0 = all; set to the LAN NIC IP to narrow it).
OPENBLADE_BIND_IP=0.0.0.0
# Bearer token for every OpenBlade-native route (Authorization: Bearer <token>).
OPENBLADE_API_TOKEN=
# Controller header token (X-Openblade-Service-Token) for /aml mount/unmount.
OPENBLADE_SERVICE_TOKEN=
# Emulated i3 AML admin / service account passwords (defaults are refused).
OPENBLADE_ADMIN_PASSWORD=
OPENBLADE_SERVICE_PASSWORD=
# Flask session signing key for the web-flask UI (port 8092).
FLASK_SECRET_KEY=
# Explicit origins only ('*' is refused). The SPA is same-origin via nginx, so
# this only matters for other browser clients, e.g. http://<lan-ip>:8091
OPENBLADE_CORS_ORIGINS=
# Leave false on plain HTTP; set true once TLS terminates in front.
OPENBLADE_WEB_SECURE_COOKIES=false
